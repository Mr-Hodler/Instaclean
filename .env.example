# Instaclean configuration. Copy to .env and edit. .env is gitignored.
# NEVER put Instagram username, password, cookies or tokens here:
# login happens manually in the browser window.

# Safety: real unlikes need BOTH this set to "false" AND the --real flag.
INSTACLEAN_DRY_RUN=true

# Operational limits (not Instagram thresholds, just local caps).
INSTACLEAN_BATCH_MIN=80
INSTACLEAN_BATCH_MAX=100
INSTACLEAN_MAX_ACTIONS_PER_SESSION=500
# Each session's cap is drawn at random in MAX +/- this (default 480-520).
INSTACLEAN_SESSION_LIMIT_JITTER=20
INSTACLEAN_INITIAL_TEST_SIZE=3

# Enforced pauses for REAL mode (hours). Self-imposed pacing, not Instagram numbers.
INSTACLEAN_MIN_HOURS_BETWEEN_SESSIONS=12
INSTACLEAN_BLOCK_COOLDOWN_HOURS=72

# Real sessions only START inside these local-time windows (morning, mid-morning,
# evening). Comma-separated HH:MM-HH:MM; empty = any hour.
INSTACLEAN_ACTIVE_HOURS=07:00-09:30,10:00-12:00,18:30-22:00
# Preferred, not mandatory: if no real session ended in the last N hours (Mac
# was off), a catch-up session may start outside the windows. 0 = strict.
INSTACLEAN_CATCHUP_AFTER_HOURS=16
# Never start a real session in these hours, catch-up included.
INSTACLEAN_QUIET_HOURS=00:30-06:30
# Unattended runs wait a random 0..N minutes (max 120) before opening the browser.
INSTACLEAN_START_JITTER_MINUTES=20

# Read-only re-checks when Instagram is slow to apply a bulk Unlike.
INSTACLEAN_VERIFY_RECHECK_SECONDS=45
INSTACLEAN_VERIFY_RECHECKS=2

# Scheduled runs (python -m instaclean --real --unattended) skip the UNLIKE prompt.
# Only normal sessions, only after all stages; pauses and stops still apply.
INSTACLEAN_ALLOW_UNATTENDED=false

# Browser window: visible | background (minimized) | headless (no window).
# headless: Instagram sees "HeadlessChrome" (nothing is hidden); log in once
# with `python -m instaclean --login` first, a headless run cannot show a login.
INSTACLEAN_BROWSER=visible

# What to unlike: all | posts (photos + carousels) | reels (videos).
INSTACLEAN_CONTENT=all

# Local logout for safety: wipe the browser profile when the login is older
# than N days (0 = never), or after every run (then you log in every time).
INSTACLEAN_SESSION_MAX_DAYS=14
INSTACLEAN_WIPE_PROFILE_AFTER_RUN=false

# Diagnostics: screenshots + DOM snapshots saved locally under debug/
# (they can show thumbnails/usernames of liked posts; stay local, gitignored).
INSTACLEAN_DEBUG=false

# Where the persistent Chromium profile lives (outside the repo by default).
INSTACLEAN_PROFILE_DIR=~/.instaclean/browser-profile
