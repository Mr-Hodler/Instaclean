# Instaclean configuration. Copy to .env and edit. .env is gitignored.
# NEVER put Instagram username, password, cookies or tokens here:
# login happens manually in the browser window.

# Safety: real unlikes need BOTH this set to "false" AND the --real flag.
INSTACLEAN_DRY_RUN=true

# Operational limits (not Instagram thresholds, just local caps).
INSTACLEAN_BATCH_MIN=80
INSTACLEAN_BATCH_MAX=100
INSTACLEAN_MAX_ACTIONS_PER_SESSION=500
INSTACLEAN_INITIAL_TEST_SIZE=3

# Enforced pauses for REAL mode (hours). Self-imposed pacing, not Instagram numbers.
INSTACLEAN_MIN_HOURS_BETWEEN_SESSIONS=12
INSTACLEAN_BLOCK_COOLDOWN_HOURS=72

# Diagnostics: screenshots + DOM snapshots saved locally under debug/
# (they can show thumbnails/usernames of liked posts; stay local, gitignored).
INSTACLEAN_DEBUG=false

# Where the persistent Chromium profile lives (outside the repo by default).
INSTACLEAN_PROFILE_DIR=~/.instaclean/browser-profile
